# Use uma imagem base do Miniconda
FROM continuumio/miniconda3

# Atualize os pacotes do sistema e instale as dependências necessárias
RUN apt-get update && apt-get install -y \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Crie um ambiente Conda e instale as dependências do GDAL
COPY requirements.txt . 
RUN conda create -n myenv python=3.10 --yes && \
    conda install -n myenv -c conda-forge gdal --yes

# Ative o ambiente e instale pacotes restantes via pip
RUN conda run -n myenv pip install --no-cache-dir -r requirements.txt

# Copie o restante do código da aplicação para o contêiner
COPY . /app
WORKDIR /app

# Exponha a porta 3002
EXPOSE 3002

# Ative o ambiente Conda e execute o aplicativo
CMD ["conda", "run", "-n", "myenv", "python", "app.py"]